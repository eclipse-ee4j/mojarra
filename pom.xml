<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.1</version>
    </parent>

   <groupId>org.glassfish.mojarra</groupId>
   <artifactId>mojarra-parent</artifactId>
   <version>5.0.0-M9</version>
   <packaging>pom</packaging>

   <name>Mojarra ${project.version} - Project</name>
   <licenses>
        <license>
            <name>EPL 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL2 w/ CPE</name>
            <url>https://www.gnu.org/software/classpath/license.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

   <modules>
        <module>impl</module>
        <module>test</module>
   </modules>

   <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.build.timestamp.format>yyyy</maven.build.timestamp.format>
    </properties>

   <build>
        <plugins>
            <!-- Sets minimal Maven version and Java version. -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.9.6</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Add missing license headers to source files. Existing headers are never rewritten: they carry third-party copyright lines. -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <!-- Configured on the plugin rather than the execution so that `mvn license:check` shares it. -->
                <configuration>
                    <skipExistingHeaders>true</skipExistingHeaders>
                    <mapping>
                        <mjs>JAVADOC_STYLE</mjs> <!-- the eslint and rollup configuration -->
                    </mapping>
                    <properties>
                        <year>${maven.build.timestamp}</year>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>${maven.multiModuleProjectDirectory}/build/license-header.txt</header>
                            <excludes>
                                <exclude>**/*.txt</exclude>
                                <exclude>**/*.options</exclude> <!-- a single substituted token -->
                                <exclude>**/.*</exclude> <!-- dotfiles -->
                                <exclude>**/.*/**</exclude>
                                <exclude>**/node_modules/**</exclude>
                                <exclude>faces/**</exclude> <!-- the API submodule, which checks its own headers -->
                                <exclude>Jenkinsfile</exclude> <!-- release infrastructure, like the workflows -->
                                <exclude>src/main/doc/*</exclude> <!-- javadoc image assets -->
                                <exclude>src/main/resources/org/glassfish/mojarra/*.xsd</exclude> <!-- schemas carry their notice in xsd:annotation, per the Jakarta EE schema convention -->
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <id>add missing license headers</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Apply code formatting (Java via Eclipse JDT, CSS/JS via Biome, XML/XHTML whitespace, TypeScript via ESLint @stylistic in impl/src/main/ts/package.json). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>format source code</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <configuration>
                            <java>
                                <eclipse>
                                    <file>${maven.multiModuleProjectDirectory}/build/eclipse-formatter.xml</file>
                                </eclipse>
                                <importOrder>
                                    <file>${maven.multiModuleProjectDirectory}/build/eclipse-importorder.txt</file>
                                </importOrder>
                                <removeUnusedImports />
                                <trimTrailingWhitespace />
                            </java>
                            <css>
                                <includes>
                                    <include>**/src/**/*.css</include>
                                </includes>
                                <excludes>
                                    <exclude>faces/**</exclude>
                                    <exclude>**/target/**</exclude>
                                    <exclude>**/node_modules/**</exclude>
                                </excludes>
                                <biome>
                                    <version>2.5.0</version> <!-- Spotless defaults to 1.2.0, which has no CSS formatter. -->
                                    <configPath>${maven.multiModuleProjectDirectory}/build</configPath>
                                </biome>
                            </css>
                            <javascript>
                                <includes>
                                    <include>**/src/**/*.js</include>
                                </includes>
                                <excludes>
                                    <exclude>faces/**</exclude>
                                    <exclude>**/target/**</exclude>
                                    <exclude>**/node_modules/**</exclude>
                                </excludes>
                                <biome>
                                    <version>2.5.0</version>
                                    <configPath>${maven.multiModuleProjectDirectory}/build</configPath>
                                </biome>
                            </javascript>
                            <formats>
                                <format>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>**/src/**/*.xml</include>
                                        <include>**/src/**/*.xhtml</include>
                                    </includes>
                                    <excludes>
                                        <exclude>faces/**</exclude>
                                        <exclude>**/target/**</exclude>
                                        <exclude>**/node_modules/**</exclude>
                                    </excludes>
                                    <trimTrailingWhitespace />
                                    <endWithNewline />
                                    <indent>
                                        <spaces>true</spaces>
                                        <spacesPerTab>4</spacesPerTab>
                                    </indent>
                                </format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Only impl is published to Maven Central, via central-publishing-maven-plugin in
                 impl/pom.xml's central-release profile. Disable the default maven-deploy-plugin
                 here so the parent pom (and any sibling module that lacks its own publishing
                 configuration) is not deployed. -->
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>api</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>

            <modules>
                <module>faces/api</module>
            </modules>
        </profile>
    </profiles>


</project>
