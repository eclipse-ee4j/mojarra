#!/usr/bin/env groovy
//
// Mojarra-vs-MyFaces perf bench, run nightly as the mojarra-perf-report job.
//
// Runs test/perf twice against Tomcat in one job -- once with the freshly built Mojarra impl, once
// with MyFaces -- and publishes a scenario x phase report. Both arms run back-to-back on the same
// agent because only the within-run ratio is meaningful: Eclipse CI agents are shared containers
// with no CPU-governor control, so absolute numbers drift between nights and comparing an arm
// against a dump from an earlier build measures the host, not the code.
//
// RELEASE_LINE picks what gets benched: the job checks out that line's branch and pairs the Mojarra
// snapshot built from it against the newest MyFaces snapshot of the same line. The nightly cron
// fires with the default parameters, so it benches the default line; any other line is a manual
// run. (Eclipse CI has no Parameterized Scheduler plugin, so a cron entry cannot carry a parameter
// of its own.)
//
// This is a plain Pipeline job whose script comes from one branch, so the checkout is explicit
// rather than the implicit `checkout scm` -- which branch holds the script must not decide which
// line gets benched.
//
// The build fails when a phase's suite total is slower than MyFaces. Only suite totals gate --
// per-scenario cells are far noisier, and a single scenario being slower is a lead to chase, not a
// broken build. FAIL_OVER widens the tolerance if a phase near parity starts flapping.
//
// Tomcat is the only server: it needs no application-server provisioning, which keeps a run
// within a sane wall-clock and keeps the measured stack down to Faces + Weld + the container.

// ---- Per-release-line configuration ---------------------------------------
// Same shape and same keys as BRANCH_CONFIG in the root Jenkinsfile: the map key is the MAJOR.MINOR
// version family, which deliberately differs from the git branch (the head of development sits on
// `master`, not on a `5.x` branch). It doubles as the MyFaces version line to resolve.
//
// Fields:
//   implBranch   : mojarra git branch holding the impl source for this line.
//   apiSubmodule : the line keeps jakarta.faces-api in the `faces` git submodule (5.0+) instead of
//                  bundling the API into the impl jar (4.x). Drives the build: the api is built
//                  into the reactor with -Papi, and test/ is reachable only through its own pom
//                  because the root reactor is impl-only there.
def LINE_CONFIG = [
    '4.1': [ implBranch: '4.1',    apiSubmodule: false ],
    '5.0': [ implBranch: 'master', apiSubmodule: true  ],
]

pipeline {

    // The bench drives the server over HttpClient (PerfBenchIT overrides BaseIT's Selenium setup),
    // so the default Jiro agent suffices -- no Chrome layer, hence no custom pod template. That
    // agent grants 2 CPU / 4Gi, which covers MAVEN_OPTS plus the managed Tomcat's heap.
    agent any

    parameters {
        choice(name: 'RELEASE_LINE', choices: ['4.1', '5.0'], description: 'Release line to benchmark: the branch that is checked out and built, and the MyFaces snapshot line it is benchmarked against. The first choice is what the nightly run benches.')
        string(name: 'PERF_WARMUP', defaultValue: '50', description: 'Warmup iterations per scenario.')
        string(name: 'PERF_RUNS', defaultValue: '1000', description: 'Measured iterations per scenario.')
        string(name: 'FAIL_OVER', defaultValue: '0', description: 'Tolerance for the regression gate, in percent: the build fails when the suite total of a phase is slower than MyFaces by more than this. 0 fails on any regression. Raise it if a phase sitting near parity starts flapping on agent noise.')
    }

    triggers {
        cron('H 2 * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '60', artifactNumToKeepStr: '60'))
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        // JDK install root layout on Eclipse CI: /opt/tools/java/<distro>/jdk-<N>/latest. Unlike the
        // root Jenkinsfile this is not per-line: every line compiles to release 17 and a cross-line
        // number is only readable when both were measured on the same JVM.
        TOOLS_PREFIX = '/opt/tools'
        JAVA_HOME    = "${TOOLS_PREFIX}/java/temurin/jdk-21/latest"
        MVN_HOME     = "${TOOLS_PREFIX}/apache-maven/latest"
        PATH         = "${MVN_HOME}/bin:${JAVA_HOME}/bin:${PATH}"
        MAVEN_OPTS   = '-Xmx2g'
        HELP_PLUGIN  = 'org.apache.maven.plugins:maven-help-plugin:3.5.1'
        // Public repo, so the URL can be spelled out instead of borrowed from `scm`, which would
        // need script approval for no gain: no credentials are involved in a read-only clone.
        REPO_URL     = 'https://github.com/eclipse-ee4j/mojarra.git'
        MYFACES_METADATA = 'https://repository.apache.org/content/repositories/snapshots/org/apache/myfaces/core/myfaces-impl/maven-metadata.xml'
        MVN_BASE     = '--batch-mode --no-transfer-progress'
        // -gs merges with the agent's own settings.xml rather than replacing it, so the Apache
        // snapshot repo can be added for the -SNAPSHOT MyFaces build without touching test/pom.xml.
        MVN_EXTRA    = "${MVN_BASE} -gs ${env.WORKSPACE}/apache-snapshots-settings.xml"
        // Nothing here is published, so the javadoc and source jars impl/pom.xml attaches are dead
        // weight on a perf bench.
        SKIP_FLAGS   = '-DskipTests -Dmaven.javadoc.skip=true -Dsource.skip=true'
        PERF_FLAGS   = "-Dperf=true -Dperf.warmup=${params.PERF_WARMUP} -Dperf.runs=${params.PERF_RUNS}"
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    def cfg = LINE_CONFIG[params.RELEASE_LINE]
                    if (cfg == null) error "Unknown RELEASE_LINE: ${params.RELEASE_LINE}. Add it to LINE_CONFIG at the top of this Jenkinsfile."

                    // The submodule holds jakarta.faces-api plus the TCK util the ITs extend, and is
                    // taken at the recorded SHA: the api this impl commit is meant to build against.
                    // Cleaning first because the workspace is reused across lines with different
                    // module layouts; nested repositories are left alone so the submodule clone
                    // survives into the next run of that line.
                    checkout([$class: 'GitSCM',
                              branches: [[name: "*/${cfg.implBranch}"]],
                              userRemoteConfigs: [[url: env.REPO_URL]],
                              extensions: [
                                  [$class: 'CleanBeforeCheckout'],
                                  [$class: 'SubmoduleOption',
                                   disableSubmodules: false,
                                   recursiveSubmodules: false,
                                   trackingSubmodules: false]
                              ]])
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.RELEASE_LINE}"
                }
            }
        }

        stage('Resolve MyFaces') {
            steps {
                script {
                    // The metadata lists every line's snapshots, hence the filter; sort -V is what
                    // makes 4.1.10 win over 4.1.9.
                    def pattern = params.RELEASE_LINE.replace('.', '\\.')
                    def version = sh(returnStdout: true, script: "curl -sf ${env.MYFACES_METADATA} | grep -oE '${pattern}\\.[0-9]+-SNAPSHOT' | sort -Vu | tail -1").trim()
                    if (!version) {
                        // Snapshot repo unreachable, or the line has no snapshot deployed yet. The
                        // version test/pom.xml pins tracks the line per branch anyway, so it is a
                        // sound second choice -- and reading a property resolves no artifact, so it
                        // needs none of the snapshot-repo settings written below.
                        sh "mvn ${env.MVN_BASE} -q -f test/pom.xml ${env.HELP_PLUGIN}:evaluate -Dexpression=myfaces.version -Doutput=${env.WORKSPACE}/myfaces.version"
                        version = readFile('myfaces.version').trim()
                    }
                    env.MYFACES_VERSION = version
                    echo "Benchmarking the ${params.RELEASE_LINE} line against MyFaces ${version}"
                }
            }
        }

        stage('Build Mojarra') {
            steps {
                // Preconfigure MyFaces snapshot repo so we can bench against its snapshots as well.
                writeFile file: 'apache-snapshots-settings.xml', text: '''<settings>
    <profiles>
        <profile>
            <id>apache-snapshots</id>
            <repositories>
                <repository>
                    <id>apache-snapshots</id>
                    <url>https://repository.apache.org/content/repositories/snapshots</url>
                    <releases><enabled>false</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles><activeProfile>apache-snapshots</activeProfile></activeProfiles>
</settings>'''
                // The bench bundles this freshly installed jar into the WAR, so it must be installed
                // before either arm runs. `clean` is mandatory: a packaged artifact is never built
                // incrementally. test/pom.xml activates its glassfish profile by default, whose
                // unpack-glassfish execution runs at pre-integration-test -- a phase `install` passes
                // through -- so it is deactivated here: installing the IT base needs no server, and
                // the bench stages provision Tomcat themselves.
                script {
                    if (LINE_CONFIG[params.RELEASE_LINE].apiSubmodule) {
                        // -am walks test/pom.xml's own reactor down to the TCK util module the IT
                        // base extends, so `base` alone selects both.
                        sh "mvn ${env.MVN_EXTRA} -Papi -pl faces/api,impl -am clean install ${env.SKIP_FLAGS}"
                        // The bench modules resolve the TCK util jar from the local repository
                        // rather than from a reactor, so util's parent pom has to be installed as
                        // well: building util alongside it only reads that parent off disk.
                        sh "mvn ${env.MVN_EXTRA} -N -f faces/tck/pom.xml clean install ${env.SKIP_FLAGS}"
                        sh "mvn ${env.MVN_EXTRA} -P '!glassfish' -f test/pom.xml -pl base -am clean install ${env.SKIP_FLAGS}"
                    }
                    else {
                        sh "mvn ${env.MVN_EXTRA} -P '!glassfish' -pl impl,test/base -am clean install ${env.SKIP_FLAGS}"
                    }
                }
                // Both arms stash their dump here, outside the target/ that the next arm's `clean` wipes.
                sh 'mkdir -p target/perf'
            }
        }

        stage('Bench Mojarra') {
            steps {
                dir('test/perf') {
                    sh "mvn ${env.MVN_EXTRA} clean verify ${env.PERF_FLAGS} -Ptomcat"
                    sh 'cp target/perf-stats-*.txt ../../target/perf/mojarra.txt'
                }
            }
        }

        stage('Bench MyFaces') {
            steps {
                dir('test/perf') {
                    sh "mvn ${env.MVN_EXTRA} clean verify ${env.PERF_FLAGS} -Ptomcat-myfaces -Dmyfaces.version=${env.MYFACES_VERSION}"
                    sh 'cp target/perf-stats-*.txt ../../target/perf/myfaces.txt'
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    // Read the version through a file rather than stdout: a stray Maven warning would
                    // otherwise end up inside the captured value. The output path must be absolute --
                    // help:evaluate resolves a relative one against the -f project's basedir, not the CWD.
                    sh "mvn ${env.MVN_EXTRA} -q -f impl/pom.xml ${env.HELP_PLUGIN}:evaluate -Dexpression=project.version -Doutput=${env.WORKSPACE}/target/perf/mojarra.version"
                    def mojarraVersion = readFile('target/perf/mojarra.version').trim()
                    // Ahead of the gate below, which fails the build on a regression: what was
                    // benched has to show up on the build whether or not it passed.
                    currentBuild.description = "Mojarra ${mojarraVersion} vs MyFaces ${env.MYFACES_VERSION} (warmup=${params.PERF_WARMUP}, runs=${params.PERF_RUNS})"
                    sh """
                        python3 test/perf/perfreport.py \\
                            target/perf/mojarra.txt target/perf/myfaces.txt \\
                            --a-label 'Mojarra ${mojarraVersion}' \\
                            --b-label 'MyFaces ${env.MYFACES_VERSION}' \\
                            --title 'Perf report #${env.BUILD_NUMBER} — ${params.RELEASE_LINE} on Tomcat' \\
                            --out target/perf/report.md \\
                            --fail-on-regression --fail-over ${params.FAIL_OVER}
                    """
                }
            }
        }
    }

    post {
        always {
            // Guarded: with no workspace (agent never allocated) archiveArtifacts throws a missing
            // FilePath context, which would bury the actual failure at the bottom of the log.
            script {
                if (env.WORKSPACE) {
                    archiveArtifacts artifacts: 'target/perf/mojarra.txt,target/perf/myfaces.txt,target/perf/report.md', allowEmptyArchive: true
                }
            }
        }
    }
}
