#!/usr/bin/env groovy
//
// Mojarra-vs-MyFaces perf bench, run nightly as the mojarra-perf-report job.
//
// For every release line it benches, the job runs test/perf twice against Tomcat -- once with the
// freshly built Mojarra impl, once with MyFaces -- and publishes a scenario x phase report. Both
// arms run back-to-back on the same agent because only the within-run ratio is meaningful: Eclipse
// CI agents are shared containers with no CPU-governor control, so absolute numbers drift between
// nights and comparing an arm against a dump from an earlier build measures the host, not the code.
//
// A line is benched by checking out its branch and pairing the Mojarra snapshot built from it
// against the newest MyFaces snapshot of the same line. The nightly cron fires with the default
// parameters, so RELEASE_LINE defaults to every line in LINE_CONFIG, run one after the other;
// narrowing it to a single line is for manual runs. (Eclipse CI has no Parameterized Scheduler
// plugin, so a cron entry cannot carry a parameter of its own.) Each line reports and archives
// under its own name, and a line that fails fails the build without costing the other its numbers.
//
// This is a plain Pipeline job whose script comes from one branch, so the checkout is explicit
// rather than the implicit `checkout scm` -- which branch holds the script must not decide which
// line gets benched.
//
// The build fails when a phase's suite total is slower than MyFaces. Only suite totals gate --
// per-scenario cells are far noisier, and a single scenario being slower is a lead to chase, not a
// broken build. FAIL_OVER widens the tolerance if a phase near parity starts flapping.
//
// Tomcat is the only server: it needs no application-server provisioning, which keeps a run
// within a sane wall-clock and keeps the measured stack down to Faces + Weld + the container.

// ---- Per-release-line configuration ---------------------------------------
// Same shape and same keys as BRANCH_CONFIG in the root Jenkinsfile: the map key is the MAJOR.MINOR
// version family, which deliberately differs from the git branch (the head of development sits on
// `master`, not on a `5.x` branch). It doubles as the MyFaces version line to resolve. Iteration
// order is the order the lines are benched in.
//
// Fields:
//   implBranch   : mojarra git branch holding the impl source for this line.
//   apiSubmodule : the line keeps jakarta.faces-api in the `faces` git submodule (5.0+) instead of
//                  bundling the API into the impl jar (4.x). Drives the build: the api is built
//                  into the reactor with -Papi, and test/ is reachable only through its own pom
//                  because the root reactor is impl-only there.
def LINE_CONFIG = [
    '4.1': [ implBranch: '4.1',    apiSubmodule: false ],
    '5.0': [ implBranch: 'master', apiSubmodule: true  ],
]

// The "bench every line" sentinel for RELEASE_LINE, and its default.
def ALL_LINES = 'all'

pipeline {

    // The bench drives the server over HttpClient (PerfBenchIT overrides BaseIT's Selenium setup),
    // so the default Jiro agent suffices -- no Chrome layer, hence no custom pod template. That
    // agent grants 2 CPU / 4Gi, which covers MAVEN_OPTS plus the managed Tomcat's heap.
    agent any

    parameters {
        choice(name: 'RELEASE_LINE', choices: ['all', '4.1', '5.0'], description: 'Release line to benchmark: the branch that is checked out and built, and the MyFaces snapshot line it is benchmarked against. "all" benches every line in turn, which is what the nightly run does.')
        string(name: 'PERF_WARMUP', defaultValue: '50', description: 'Warmup iterations per scenario.')
        string(name: 'PERF_RUNS', defaultValue: '1000', description: 'Measured iterations per scenario.')
        string(name: 'FAIL_OVER', defaultValue: '0', description: 'Tolerance for the regression gate, in percent: the build fails when the suite total of a phase is slower than MyFaces by more than this. 0 fails on any regression. Raise it if a phase sitting near parity starts flapping on agent noise.')
    }

    triggers {
        cron('H 2 * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '60', artifactNumToKeepStr: '60'))
        // Covers every line in LINE_CONFIG, each with its own build and two bench arms.
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        // JDK install root layout on Eclipse CI: /opt/tools/java/<distro>/jdk-<N>/latest. Unlike the
        // root Jenkinsfile this is not per-line: every line compiles to release 17 and a cross-line
        // number is only readable when both were measured on the same JVM.
        TOOLS_PREFIX = '/opt/tools'
        JAVA_HOME    = "${TOOLS_PREFIX}/java/temurin/jdk-21/latest"
        MVN_HOME     = "${TOOLS_PREFIX}/apache-maven/latest"
        PATH         = "${MVN_HOME}/bin:${JAVA_HOME}/bin:${PATH}"
        MAVEN_OPTS   = '-Xmx2g'
        HELP_PLUGIN  = 'org.apache.maven.plugins:maven-help-plugin:3.5.1'
        // Public repo, so the URL can be spelled out instead of borrowed from `scm`, which would
        // need script approval for no gain: no credentials are involved in a read-only clone.
        REPO_URL     = 'https://github.com/eclipse-ee4j/mojarra.git'
        MYFACES_METADATA = 'https://repository.apache.org/content/repositories/snapshots/org/apache/myfaces/core/myfaces-impl/maven-metadata.xml'
        MVN_BASE     = '--batch-mode --no-transfer-progress'
        // -gs merges with the agent's own settings.xml rather than replacing it, so the Apache
        // snapshot repo can be added for the -SNAPSHOT MyFaces build without touching test/pom.xml.
        MVN_EXTRA    = "${MVN_BASE} -gs ${env.WORKSPACE}/apache-snapshots-settings.xml"
        // Nothing here is published, so the javadoc and source jars impl/pom.xml attaches are dead
        // weight on a perf bench.
        SKIP_FLAGS   = '-DskipTests -Dmaven.javadoc.skip=true -Dsource.skip=true'
        // test/pom.xml activates its glassfish profile by default, whose unpack-glassfish execution
        // runs at pre-integration-test -- a phase `install` passes through. Installing the IT base
        // needs no server at all, so the whole distribution download is skipped here; the bench
        // stages provision their own Tomcat through -Ptomcat.
        NO_GLASSFISH    = "-P '!glassfish'"
        PERF_FLAGS   = "-Dperf=true -Dperf.warmup=${params.PERF_WARMUP} -Dperf.runs=${params.PERF_RUNS}"
    }

    stages {

        stage('Bench release lines') {
            steps {
                script {
                    def lines = params.RELEASE_LINE == ALL_LINES ? LINE_CONFIG.keySet().toList() : [params.RELEASE_LINE]
                    def unknown = lines.findAll { !LINE_CONFIG.containsKey(it) }
                    if (unknown) error "Unknown release line(s) ${unknown}. Add them to LINE_CONFIG at the top of this Jenkinsfile."

                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${lines.join(' + ')}"
                    def benched = []

                    for (line in lines) {
                        def cfg = LINE_CONFIG[line]

                        // One line going down must not cost the others their numbers, so a failure
                        // marks the build and the loop carries on. Archiving sits outside the guard
                        // to keep the dumps of a line whose gate tripped.
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {

                            stage("${line}: checkout") {
                                // The submodule holds jakarta.faces-api plus the TCK util the ITs
                                // extend, and is taken at the recorded SHA: the api this impl commit
                                // is meant to build against. Cleaning first because the workspace is
                                // reused across lines with different module layouts; nested
                                // repositories are left alone so the submodule clone survives.
                                checkout([$class: 'GitSCM',
                                          branches: [[name: "*/${cfg.implBranch}"]],
                                          userRemoteConfigs: [[url: env.REPO_URL]],
                                          extensions: [
                                              [$class: 'CleanBeforeCheckout'],
                                              [$class: 'SubmoduleOption',
                                               disableSubmodules: false,
                                               recursiveSubmodules: false,
                                               trackingSubmodules: false]
                                          ]])
                                // Preconfigure MyFaces snapshot repo so we can bench against its
                                // snapshots as well. Rewritten per line: the checkout above cleans
                                // it away along with the previous line's build output.
                                writeFile file: 'apache-snapshots-settings.xml', text: '''<settings>
    <profiles>
        <profile>
            <id>apache-snapshots</id>
            <repositories>
                <repository>
                    <id>apache-snapshots</id>
                    <url>https://repository.apache.org/content/repositories/snapshots</url>
                    <releases><enabled>false</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles><activeProfile>apache-snapshots</activeProfile></activeProfiles>
</settings>'''
                            }

                            def myfacesVersion = ''

                            stage("${line}: resolve MyFaces") {
                                // The metadata lists every line's snapshots, hence the filter; sort
                                // -V is what makes 4.1.10 win over 4.1.9.
                                def pattern = line.replace('.', '\\.')
                                myfacesVersion = sh(returnStdout: true, script: "curl -sf ${env.MYFACES_METADATA} | grep -oE '${pattern}\\.[0-9]+-SNAPSHOT' | sort -Vu | tail -1").trim()
                                if (!myfacesVersion) {
                                    // Snapshot repo unreachable, or the line has no snapshot
                                    // deployed yet. The version test/pom.xml pins tracks the line
                                    // per branch anyway, so it is a sound second choice.
                                    sh "mvn ${env.MVN_EXTRA} -q -f test/pom.xml ${env.HELP_PLUGIN}:evaluate -Dexpression=myfaces.version -Doutput=${env.WORKSPACE}/myfaces.version"
                                    myfacesVersion = readFile('myfaces.version').trim()
                                }
                                echo "Benchmarking the ${line} line against MyFaces ${myfacesVersion}"
                            }

                            stage("${line}: build Mojarra") {
                                // The bench bundles this freshly installed jar into the WAR, so it
                                // must be installed before either arm runs. `clean` is mandatory: a
                                // packaged artifact is never built incrementally.
                                if (cfg.apiSubmodule) {
                                    // -am walks test/pom.xml's own reactor down to the TCK util
                                    // module the IT base extends, so `base` alone selects both.
                                    sh "mvn ${env.MVN_EXTRA} -Papi -pl faces/api,impl -am clean install ${env.SKIP_FLAGS}"
                                    sh "mvn ${env.MVN_EXTRA} ${env.NO_GLASSFISH} -f test/pom.xml -pl base -am clean install ${env.SKIP_FLAGS}"
                                }
                                else {
                                    sh "mvn ${env.MVN_EXTRA} ${env.NO_GLASSFISH} -pl impl,test/base -am clean install ${env.SKIP_FLAGS}"
                                }
                                // Both arms stash their dump here, outside the target/ that the next
                                // arm's `clean` wipes.
                                sh 'mkdir -p target/perf'
                            }

                            stage("${line}: bench Mojarra") {
                                dir('test/perf') {
                                    sh "mvn ${env.MVN_EXTRA} clean verify ${env.PERF_FLAGS} -Ptomcat"
                                    sh "cp target/perf-stats-*.txt ../../target/perf/mojarra-${line}.txt"
                                }
                            }

                            stage("${line}: bench MyFaces") {
                                dir('test/perf') {
                                    sh "mvn ${env.MVN_EXTRA} clean verify ${env.PERF_FLAGS} -Ptomcat-myfaces -Dmyfaces.version=${myfacesVersion}"
                                    sh "cp target/perf-stats-*.txt ../../target/perf/myfaces-${line}.txt"
                                }
                            }

                            stage("${line}: report") {
                                // Read the version through a file rather than stdout: a stray Maven
                                // warning would otherwise end up inside the captured value. The
                                // output path must be absolute -- help:evaluate resolves a relative
                                // one against the -f project's basedir, not the CWD.
                                sh "mvn ${env.MVN_EXTRA} -q -f impl/pom.xml ${env.HELP_PLUGIN}:evaluate -Dexpression=project.version -Doutput=${env.WORKSPACE}/target/perf/mojarra.version"
                                def mojarraVersion = readFile('target/perf/mojarra.version').trim()
                                benched << "${line}: Mojarra ${mojarraVersion} vs MyFaces ${myfacesVersion}"
                                currentBuild.description = benched.join(' | ') + " (warmup=${params.PERF_WARMUP}, runs=${params.PERF_RUNS})"
                                sh """
                                    python3 test/perf/perfreport.py \\
                                        target/perf/mojarra-${line}.txt target/perf/myfaces-${line}.txt \\
                                        --a-label 'Mojarra ${mojarraVersion}' \\
                                        --b-label 'MyFaces ${myfacesVersion}' \\
                                        --title 'Perf report #${env.BUILD_NUMBER} — ${line} on Tomcat' \\
                                        --out target/perf/report-${line}.md \\
                                        --fail-on-regression --fail-over ${params.FAIL_OVER}
                                """
                            }
                        }

                        archiveArtifacts artifacts: "target/perf/mojarra-${line}.txt,target/perf/myfaces-${line}.txt,target/perf/report-${line}.md", allowEmptyArchive: true
                    }
                }
            }
        }
    }
}
